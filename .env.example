# Copy this file to .env and set your own values. Never commit .env.

# --- PostgreSQL of this project (compose.yaml) ---
POSTGRES_USER=orders
POSTGRES_PASSWORD=change_me
POSTGRES_DB=orders
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# --- Email protection keys (names only; generate your own values) ---
# HMAC key for the pseudonym
PII_HMAC_KEY=
# key for the reversible encryption
PII_ENCRYPTION_KEY=
